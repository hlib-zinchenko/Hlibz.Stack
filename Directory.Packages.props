<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <!--
        The Hlibz packages this repository exists to try together: the .NET 11 majors' previews
        (Results 3, UseCases 2, OpenApi 2, MinimalApi.Endpoints 2) and McpDocs 0.3.
    -->
  <ItemGroup>
    <PackageVersion Include="Hlibz.EntityFrameworkCore.ModelRules" Version="2.0.0" />
    <PackageVersion Include="Hlibz.McpDocs.AspNetCore" Version="0.3.0-preview.1" />
    <PackageVersion Include="Hlibz.MinimalApi.Endpoints" Version="2.0.0-preview.1" />
    <PackageVersion Include="Hlibz.OpenApi.Paging" Version="2.0.0-preview.2" />
    <PackageVersion Include="Hlibz.OpenApi.Results" Version="2.0.0-preview.2" />
    <PackageVersion Include="Hlibz.OpenApi.UseCases" Version="2.0.0-preview.2" />
    <PackageVersion Include="Hlibz.Paging" Version="1.1.0" />
    <PackageVersion Include="Hlibz.Paging.EntityFrameworkCore" Version="1.1.0" />
    <PackageVersion Include="Hlibz.Redoc.AspNetCore" Version="2.6.0" />
    <PackageVersion Include="Hlibz.Results" Version="3.0.0-preview.2" />
    <PackageVersion Include="Hlibz.Results.AspNetCore" Version="3.0.0-preview.2" />
    <PackageVersion Include="Hlibz.Results.Mcp" Version="3.0.0-preview.2" />
    <PackageVersion Include="Hlibz.TypeRules.Analyzers" Version="1.0.0" />
    <PackageVersion Include="Hlibz.UseCases" Version="2.0.0-preview.2" />
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Include="EFCore.NamingConventions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="11.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.4.0" />
    <PackageVersion Include="Nullable.Extended.Analyzer" Version="1.19.0" />
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.37.0.15768" />
    <PackageVersion Include="StronglyTypedId" Version="1.0.0-beta08" />
    <PackageVersion Include="StyleCop.Analyzers" Version="1.3.180" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>
</Project>